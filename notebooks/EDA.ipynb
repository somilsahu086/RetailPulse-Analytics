   "source": [
    "## 4. Data Type Cleaning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5a68e453",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "df[\"InvoiceDate\"] = pd.to_datetime(df[\"InvoiceDate\"], errors=\"coerce\")\n",
    "\n",
    "df[\"Quantity\"] = pd.to_numeric(\n",
    "    df[\"Quantity\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "df[\"Price\"] = pd.to_numeric(\n",
    "    df[\"Price\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "print(df.dtypes)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7733f85a",
   "metadata": {},
   "source": [
    "## 5. Missing Value Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f13a4fff",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "missing = df.isnull().sum().sort_values(ascending=False)\n",
    "missing_percent = (df.isnull().mean() * 100).sort_values(ascending=False)\n",
    "\n",
    "missing_summary = pd.DataFrame({\n",
    "    \"Missing Values\": missing,\n",
    "    \"Missing Percentage\": missing_percent.round(2)\n",
    "})\n",
    "\n",
    "display(missing_summary[missing_summary[\"Missing Values\"] > 0])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6d66a8b5",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "missing_plot = missing_percent[missing_percent > 0]\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "missing_plot.plot(kind=\"bar\")\n",
    "plt.title(\"Missing Values by Column\")\n",
    "plt.xlabel(\"Column\")\n",
    "plt.ylabel(\"Missing Percentage (%)\")\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
