    "\n",
    "file = \"data\online_retail_II.xlsx\"\n",
    "\n",
    "df_2009 = pd.read_excel(\n",
    "    file,\n",
    "    sheet_name=\"Year 2009-2010\"\n",
    ")\n",
    "\n",
    "df_2010 = pd.read_excel(\n",
    "    file,\n",
    "    sheet_name=\"Year 2010-2011\"\n",
    ")\n",
    "\n",
    "print(\"2009-2010 shape:\", df_2009.shape)\n",
    "print(\"2010-2011 shape:\", df_2010.shape)\n"
   ]
